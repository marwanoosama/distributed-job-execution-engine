    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobEngine.Domain\JobEngine.Domain.csproj" />
  </ItemGroup>

</Project>
